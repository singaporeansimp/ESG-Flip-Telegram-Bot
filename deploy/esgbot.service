# The ESG Flip bot: one process, long polling, SQLite on local disk.
#
# Install it as described in the README's "Deploying on a VPS", which assumes
# this layout. Change the paths here if yours differs.
#
#   /opt/esgbot              the checkout, read-only to the service
#   /opt/esgbot/.venv        the environment "uv sync --no-dev" built
#   /var/lib/esgbot          the database, created by StateDirectory below
#   /etc/esgbot/esgbot.env   the token, root-owned and chmod 0600
#
# Two things to know before using it.
#
# Exactly one instance may poll. Two pollers on one token fight over updates, so
# never start the bot by hand while this unit is active, and do not add a second
# instance of it.
#
# A restart voids any flip that is in progress. That is by design: the bot holds
# a running flip in memory, so the next start finds the leftover row, tells the
# group the flip was voided and reveals its seed. Deploying mid-flip costs that
# flip -- nobody's recorded history, just the round on screen. "systemctl status
# esgbot" during a quiet minute is the polite way to avoid it.

[Unit]
Description=ESG Flip Telegram bot
Documentation=file:/opt/esgbot/README.md
After=network-online.target
Wants=network-online.target
# The bot exits rather than retrying if its first call to Telegram fails, so a
# revoked token and a network that is not up yet look the same for the first few
# seconds. Ten tries over ten minutes rides out the slow boot and still gives up
# on something that is never going to work -- "systemctl status esgbot" then says
# so, instead of the journal filling for ever.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=esgbot
Group=esgbot
WorkingDirectory=/opt/esgbot

# The token and the database path. systemd reads this as root, before dropping
# to the service user, so the file can and should be root-owned and chmod 0600:
# the bot's own user never needs to read it.
EnvironmentFile=/etc/esgbot/esgbot.env

# The checkout is read-only to this service (ProtectSystem=strict below), so
# bytecode cannot be cached there; say so rather than having Python find out.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

# The virtual environment's interpreter, not "uv run": uv may want to write to
# the checkout and to a cache, and both are read-only here. Upgrades run
# "uv sync --no-dev" by hand, which is also where a dependency change belongs.
ExecStart=/opt/esgbot/.venv/bin/python -m esgbot

# /var/lib/esgbot, created on first start and owned by the service user. This is
# where ESGBOT_DB_PATH should point.
StateDirectory=esgbot
StateDirectoryMode=0700
UMask=0077

Restart=on-failure
RestartSec=15s
# On SIGTERM the bot stops polling, closes the database and exits 0, which takes
# well under a second. This is only the ceiling before SIGKILL.
TimeoutStopSec=30

# Logs: the bot writes to stderr, which journald collects.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=esgbot

# Hardening. The bot needs outbound HTTPS to api.telegram.org, its own state
# directory, and nothing else at all.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
