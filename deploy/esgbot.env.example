# The bot's environment, read by esgbot.service. Copy it into place with
#
#   install -D -m 0600 -o root -g root deploy/esgbot.env.example /etc/esgbot/esgbot.env
#
# and then edit the token in. Keep it at 0600 and root-owned: systemd reads this
# file as root before dropping to the esgbot user, so the service's own user
# never needs access to it.
#
# This is systemd's EnvironmentFile syntax, not a shell script. One KEY=value per
# line, no "export", no $OTHER_VARIABLE expansion, and no quotes needed around a
# token -- quotes that are there are stripped, so a value is never meant to
# contain them.

# Required. The token @BotFather gave you, in the form 123456789:AA... The bot
# never logs it. A wrong one ends the process on its first call to Telegram, with
# "TelegramUnauthorizedError: Telegram server says - Unauthorized" at the foot of
# a traceback in the journal; systemd then retries and eventually gives up.
ESGBOT_TELEGRAM_TOKEN=123456789:replace-this-with-the-token-from-botfather

# Optional, defaults to esgbot.sqlite3 in the working directory, which is the
# read-only checkout -- so set it. /var/lib/esgbot is the StateDirectory the unit
# creates for exactly this. esgbot-backup.service needs to be told the same path.
ESGBOT_DB_PATH=/var/lib/esgbot/esgbot.sqlite3

# Optional, defaults to INFO. DEBUG is loud but is the one to use when a flip
# behaves oddly: it adds every gateway call and timer.
ESGBOT_LOG_LEVEL=INFO
